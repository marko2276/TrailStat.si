# Copy to .env and adjust. .env is ignored by git.

# Which compose files to use. For production-like runs use only compose.yaml.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Database
POSTGRES_USER=trailstat
POSTGRES_DB=trailstat
# Required. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public address served by Caddy (compose.yaml only).
# Use the bare domain in production, e.g. trailstat.si, to get automatic HTTPS.
SITE_ADDRESS=http://localhost
# In production set these to 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# Directory with Copernicus DEM GeoTIFF files, mounted read-only into the backend.
DEM_DIR=./data/dem

# Hanko API URL. In development it falls back to HANKO_TRAILSTAT_SANDBOX_API from .envrc.
HANKO_API_URL=
# When set, tokens must be issued for this audience. In production: trailstat.si
HANKO_AUDIENCE=
