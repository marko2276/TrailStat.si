# Copy to .env and adjust. .env is ignored by git.

# Which compose files to use. For production-like runs use only compose.yaml.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# development or production. In production the backend refuses to start unless HANKO_API_URL,
# HANKO_AUDIENCE, SMTP_HOST and an https:// APP_URL are set, and /api/docs is off.
# See the production checklist in docs/development.md.
ENVIRONMENT=development

# Database
POSTGRES_USER=trailstat
POSTGRES_DB=trailstat
# Required. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public address served by Caddy (compose.yaml only).
# Use the bare domain in production, e.g. trailstat.si, to get automatic HTTPS.
SITE_ADDRESS=http://localhost
# In production set these to 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# Directory with Copernicus DEM GeoTIFF files, mounted read-only into the backend.
DEM_DIR=./data/dem

# Overpass API used to search and import OpenStreetMap routes.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Map style for MapLibre. The default needs no API key.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Hanko API URL. In development it falls back to HANKO_TRAILSTAT_SANDBOX_API from .envrc.
HANKO_API_URL=
# When set, tokens must be issued for this audience. In production: trailstat.si
HANKO_AUDIENCE=

# Outgoing e-mail (invitations). In development everything goes to Mailpit and these are ignored.
# Production uses Scaleway Transactional Email (ADR 0006): SMTP_HOST=smtp.tem.scaleway.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM='"TrailStat.si" <noreply@trailstat.si>'
SMTP_STARTTLS=true
# Address of the app, for links in e-mails. In production: https://trailstat.si
APP_URL=

# Donations by bank transfer, shown with a UPN QR code on the support page (/support).
# Off while DONATION_IBAN is empty. The name and city are the account holder's, as on a payment
# order; the street may stay empty, as it is shown publicly. The backend refuses to start with
# an invalid IBAN, or details too long for a UPN (33 characters, 42 for the purpose).
DONATION_IBAN=
DONATION_NAME=
DONATION_STREET=
DONATION_CITY=
# DONATION_PURPOSE=Donacija TrailStat.si
# Hanko user IDs (comma-separated) that may open the admin page (/admin): totals of users,
# trails and hikes, database size and server status. Find yours in the Hanko console, under
# Users. Empty: nobody.
ADMIN_USER_IDS=
# Shown on the admin page. When deploying: APP_VERSION=$(git rev-parse --short HEAD)
# APP_VERSION=dev

# Donations with Flik, to this Slovenian phone number, shown publicly. Off while empty. Works
# with or without DONATION_IBAN.
DONATION_FLIK_NUMBER=
