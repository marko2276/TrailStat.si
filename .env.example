# Copy to .env and adjust. .env is ignored by git.

# Which compose files to use. For production-like runs use only compose.yaml.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# development or production. In production the backend refuses to start unless HANKO_API_URL,
# HANKO_AUDIENCE, SMTP_HOST and an https:// APP_URL are set, and /api/docs is off.
# See the production checklist in docs/development.md.
ENVIRONMENT=development

# Database
POSTGRES_USER=trailstat
POSTGRES_DB=trailstat
# Required. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public address served by Caddy (compose.yaml only).
# Use the bare domain in production, e.g. trailstat.si, to get automatic HTTPS.
SITE_ADDRESS=http://localhost
# In production set these to 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# Directory with Copernicus DEM GeoTIFF files, mounted read-only into the backend.
DEM_DIR=./data/dem

# Overpass API used to search and import OpenStreetMap routes.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Map style for MapLibre. The default needs no API key.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Hanko API URL. In development it falls back to HANKO_TRAILSTAT_SANDBOX_API from .envrc.
HANKO_API_URL=
# When set, tokens must be issued for this audience. In production: trailstat.si
HANKO_AUDIENCE=

# Outgoing e-mail (invitations). In development everything goes to Mailpit and these are ignored.
# Production uses Scaleway Transactional Email (ADR 0006): SMTP_HOST=smtp.tem.scaleway.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TrailStat <noreply@trailstat.si>"
SMTP_STARTTLS=true
# Address of the app, for links in e-mails. In production: https://trailstat.si
APP_URL=
